# Copy to deploy/.env.production and fill the required values.
# Keep the copied file outside Git. Never put real business data, passwords or
# tokens in the image or in a repository.

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# The data volume is persistent and shared by web and worker.
DATABASE_PATH=/var/lib/budget/db.sqlite3
BUDGET_STORAGE_ROOT=/var/lib/budget/storage
SOFFICE_BIN=/usr/bin/soffice
BUDGET_PROCESS_UPLOAD_INLINE=0

# Used by the optional Caddy profile after a real domain is configured.
BUDGET_DOMAIN=budget.example.com

# Compose interpolation only; do not expose the web service publicly.
WEB_BIND=127.0.0.1
PORT=8000
