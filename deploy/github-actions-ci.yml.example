name: CI

on:
  push:
  pull_request:

permissions:
  contents: read

env:
  DJANGO_SETTINGS_MODULE: config.settings
  DJANGO_DEBUG: "1"
  DJANGO_SECRET_KEY: ci-only-secret-not-for-production
  DJANGO_ALLOWED_HOSTS: testserver,localhost,127.0.0.1
  CSRF_TRUSTED_ORIGINS: http://testserver,http://localhost
  DATABASE_PATH: ${{ runner.temp }}/budget-ci.sqlite3
  BUDGET_STORAGE_ROOT: ${{ runner.temp }}/budget-ci-storage
  BUDGET_PROCESS_UPLOAD_INLINE: "1"

jobs:
  lint-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Check out source
        uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"
          cache: pip
      - name: Install dependencies
        run: python -m pip install -r requirements.txt ruff==0.15.12
      - name: Ruff
        run: ruff check .
      - name: Django checks
        run: python manage.py check
      - name: Django tests
        run: python manage.py test --noinput

  image-build:
    runs-on: ubuntu-latest
    needs: lint-and-test
    steps:
      - name: Check out source
        uses: actions/checkout@v4
      - name: Build production image
        run: docker build --tag hotel-budget:ci .
