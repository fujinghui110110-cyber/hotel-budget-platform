# Mac 本机生产配置示例。
# 复制到项目根目录的 .env.production 后再按本机目录修改；不要提交 .env.production。
# 当前配置只绑定本机 HTTP，不开启公网访问。

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=0
# 替换为至少 50 个字符的随机值；保留 CHANGE_ME 会被正式配置拒绝。
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8768,http://localhost:8768
TRUST_PROXY=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# 建议放在 Git checkout 之外的本机受控数据目录；请改成实际用户名和目录。
DATABASE_PATH=/Users/your-account/预算系统数据/db.sqlite3
BUDGET_STORAGE_ROOT=/Users/your-account/预算系统数据/storage
SOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
BUDGET_PROCESS_UPLOAD_INLINE=0
PORT=8768
