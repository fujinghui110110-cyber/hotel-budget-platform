# Local-only example. Copy this file to .env and review it before sourcing.
# Do not put passwords, tokens, or real business data here.

# Django reads these values from config/settings.py.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-mvp-change-before-network-deploy
DATABASE_PATH=./db.sqlite3
BUDGET_STORAGE_ROOT=./storage

# Optional: set this to the executable installed on this Mac when needed.
# SOFFICE_BIN=/opt/homebrew/bin/soffice

# The local launch scripts read PORT and always bind Web to 127.0.0.1.
PORT=8768
